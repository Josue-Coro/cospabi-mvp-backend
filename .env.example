# Ejemplo del archivo .env (este SI se puede subir a GitHub: no tiene datos reales).
# El archivo .env verdadero se crea con:  python configurar.py

DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SECRET_KEY=una_clave_larga_de_al_menos_32_caracteres
ADMIN_USUARIO=admin
ADMIN_CLAVE=admin123

# Opcionales
# Origenes permitidos (URLs de Vercel separadas por comas); por defecto cualquiera
CORS_ORIGENES=*
# NIT de la cooperativa que se imprime en la factura simulada
FACTURA_NIT_EMISOR=0000000000
# Esquema de PostgreSQL alternativo para probar sin tocar los datos reales (por defecto: public)
# DB_ESQUEMA=prueba

# Pasarela de pagos Libelula (pago con QR del portal del socio)
LIBELULA_APPKEY=llave_que_asigna_libelula
# URL del portal del socio (Libelula devuelve ahi al socio tras pagar)
PORTAL_URL=https://cospabi-socio.vercel.app
# URL publica de esta API para el callback; en Render se toma sola de RENDER_EXTERNAL_URL
# API_PUBLICA_URL=https://cospabi-mvp-backend.onrender.com
